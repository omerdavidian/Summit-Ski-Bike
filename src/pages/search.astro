---
const pages=Object.values(import.meta.glob('../content/*.json',{eager:true,import:'default'})).map((page:any)=>{
  const title=page.head.match(/<title>(.*?)<\/title>/)?.[1]||'Summit';
  const path=page.head.match(/rel="canonical"[^>]*href="([^"]+)"/)?.[1]||page.head.match(/href="([^"]+)"[^>]*rel="canonical"/)?.[1]||'/';
  const text=page.body.replace(/<style[^>]*>[\s\S]*?<\/style>/g,'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ');
  return {title,path:path.replace('https://summitskibike.com','')||'/',text};
});
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,follow"/><title>Search | Summit Ski Bike</title><style>body{margin:0;background:#f1f5f8;color:#10223d;font:17px/1.6 Arial,sans-serif}header{padding:24px;background:#001d3d}main{max-width:800px;padding:32px 24px;margin:auto}input{padding:14px;border:1px solid #bccbd5;border-radius:4px;font:inherit;max-width:100%;box-sizing:border-box}button{padding:15px;background:#176aa6;color:white;border:0;border-radius:4px;font:inherit}article{padding:20px 0;border-bottom:1px solid #cfdae2}a{color:#1766a3}h2{font-size:22px}form{display:flex;gap:12px;flex-wrap:wrap;align-items:center}form label{flex-basis:100%}form br{display:none}form input{flex:1;min-width:160px}button{min-height:48px}input:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid #176aa6;outline-offset:3px}</style></head><body><header><a href="/"><img width="220" src="/email/logo.png" alt="Summit Ski Bike"/></a></header><main><h1>Search the Summit archive</h1><form action="/search/"><label for="q">Search pages</label><br/><input id="q" name="q" type="search" maxlength="100"/><button type="submit">Search</button></form><p id="summary" role="status"></p><section id="results" aria-label="Search results"></section><a href="/">← Return to Summit</a></main><script define:vars={{pages}}>
const query=(new URLSearchParams(location.search).get('q')||'').trim().slice(0,100);document.querySelector('#q').value=query;
if(!query)document.querySelector('#summary').textContent='Enter a word or phrase to search the archive.';
if(query){const terms=query.toLowerCase().split(/\s+/);const matches=pages.filter(p=>terms.every(t=>(p.title+' '+p.text).toLowerCase().includes(t)));document.querySelector('#summary').textContent=`${matches.length} result${matches.length===1?'':'s'} for “${query}”`;for(const page of matches){const article=document.createElement('article');const heading=document.createElement('h2');const link=document.createElement('a');link.href=page.path;link.textContent=page.title;heading.append(link);const paragraph=document.createElement('p');const index=page.text.toLowerCase().indexOf(terms[0]);paragraph.textContent=page.text.slice(Math.max(0,index-60),Math.max(0,index-60)+240)+'…';article.append(heading,paragraph);document.querySelector('#results').append(article);}}
</script></body></html>
